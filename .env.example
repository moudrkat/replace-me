# Where the local model lives (OpenAI-compatible: ollama, vLLM, llama.cpp,
# brainscope...). E.g. ollama: http://127.0.0.1:11434/v1
REPLACEME_LLM_URL=
REPLACEME_LLM_KEY=
REPLACEME_MODEL=gemma-4-e4b
# 0 = text-only backend: no camera frames are ever sent, the character
# admits to being blind instead.
REPLACEME_LLM_VISION=1

# Daemon port (face at http://127.0.0.1:8765/), data dir (default
# ~/.replace-me), microphone source (pactl list short sources), whisper
# model size, camera device.
REPLACEME_PORT=8765
REPLACEME_DIR=
REPLACEME_MIC=default
REPLACEME_STT_MODEL=small
REPLACEME_CAMERA=/dev/video0

# Character file (default: CHARACTER.md at the repo root; see
# characters/example.md). These override the file:
REPLACEME_CHARACTER=
REPLACEME_NAMES=
# Empty REPLACEME_VOICE (set but blank) disables text-to-speech entirely.
REPLACEME_VOICE=en-US-AriaNeural
REPLACEME_VOICE_RATE=+0%

# Privacy: 1 = the MCP tools (room_listen/room_recent) return ONLY
# [HANDOFF] task briefs written by the local brain after spoken consent.
# Raw meeting speech then never reaches the agent session. Empty = full
# presence (the session reads the whole transcript).
REPLACEME_PRIVATE=

# 1 = the character knows its forward pass is being watched live in an
# interpretability tool, and may dryly comment.
REPLACEME_BRAIN_OBSERVED=
